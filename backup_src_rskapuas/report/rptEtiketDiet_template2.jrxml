<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptEtiketDiet_template2" pageWidth="609" pageHeight="935" orientation="Portrait" columnWidth="191" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" columnSpacing="4" columnCount="3" printOrder="Horizontal" uuid="a1b2c3d4-e5f6-47a8-9b0c-1d2e3f4a5b6c">
